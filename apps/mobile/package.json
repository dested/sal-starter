{
  "name": "@app/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun ../../scripts/dev.ts mobile",
    "typecheck": "tsc --noEmit",
    "doctor": "bunx expo-doctor && expo-modules-autolinking verify",
    "doctor:fix": "expo install --check",
    "add-device": "eas device:create",
    "ios:prebuild": "cross-env APP_VARIANT=development expo prebuild -p ios --clean",
    "ios:device": "cross-env APP_VARIANT=development expo run:ios --device --no-bundler",
    "ios:sim": "cross-env APP_VARIANT=development expo run:ios",
    "fingerprint": "bunx @expo/fingerprint .",
    "build:dev": "eas build -p ios --profile development",
    "build:preview": "eas build -p ios --profile preview",
    "build:prod": "eas build -p ios --profile production",
    "submit:prod": "eas submit -p ios --profile production",
    "ota:preview": "cross-env APP_VARIANT=preview eas update --channel preview --environment preview",
    "ota:promote": "eas update:republish --channel preview --destination-channel production --non-interactive",
    "ota:prod": "cross-env APP_VARIANT=production eas update --channel production --environment production"
  },
  "dependencies": {
    "@app/native-example": "workspace:*",
    "@app/tokens": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "catalog:",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "superjson": "catalog:",
    "tailwind-merge": "catalog:",
    "uniwind": "1.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/web": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "cross-env": "^7.0.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
