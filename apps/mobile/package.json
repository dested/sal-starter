{
  "name": "@app/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun ../../scripts/dev.ts mobile",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor && expo-modules-autolinking verify",
    "doctor:fix": "expo install --check",
    "add-device": "eas device:create",
    "ios:prebuild": "cross-env APP_VARIANT=development expo prebuild -p ios --clean",
    "ios:device": "cross-env APP_VARIANT=development expo run:ios --device --no-bundler",
    "ios:sim": "cross-env APP_VARIANT=development expo run:ios",
    "fingerprint": "bunx @expo/fingerprint .",
    "build:dev": "eas build -p ios --profile development",
    "build:preview": "eas build -p ios --profile preview",
    "build:prod": "eas build -p ios --profile production",
    "submit:prod": "eas submit -p ios --profile production",
    "ota:preview": "eas update --channel preview --environment preview",
    "ota:prod": "eas update --channel production --environment production"
  },
  "dependencies": {
    "@app/native-example": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "nativewind": "5.0.0-rc.0",
    "react": "catalog:",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "superjson": "catalog:",
    "tailwind-merge": "^2.5.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/web": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^22.10.0",
    "@types/react": "catalog:",
    "cross-env": "^7.0.3",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
