{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "server.ts",
    "vite.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "allowJs": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
