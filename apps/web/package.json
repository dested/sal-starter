{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./router": "./server/router.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch server.ts",
    "build": "bun run clean && bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "cross-env NODE_ENV=production bun server.ts",
    "start:local": "cross-env NODE_ENV=production bun --env-file=../../.env server.ts",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:sql": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "bun --env-file=../../.env test ./src ./server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@app/tokens": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cross-env": "^7.0.3",
    "express": "^5.3.0",
    "lucide-react": "catalog:",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.18.4",
    "rimraf": "^6.0.1",
    "superjson": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.2.0",
    "typescript": "catalog:",
    "vite": "^6.4.5"
  }
}
