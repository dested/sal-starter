{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "electron.vite.config.ts"],
  "exclude": ["node_modules", "out", "release"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "target": "ES2022",
    "types": ["bun", "node", "vite/client"],
    "paths": {
      "~/*": ["./src/renderer/src/*"]
    }
  }
}
