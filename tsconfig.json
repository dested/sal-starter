{
  "extends": "./tsconfig.base.json",
  "include": ["scripts/**/*.ts", "recipes/*.ts", "recipes/*/recipe.ts", "prettier.config.js"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": true,
    "types": ["bun"]
  }
}
