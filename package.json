{
  "name": "sal-starter",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "zod": "^4.6.7",
      "@trpc/server": "11.19.0",
      "@trpc/client": "11.19.0",
      "@trpc/tanstack-react-query": "11.19.0",
      "@tanstack/react-query": "^5.104.5",
      "superjson": "2.2.6",
      "better-auth": "1.7.12",
      "@better-auth/expo": "1.7.12",
      "prisma": "~7.10.1",
      "@prisma/client": "~7.10.1",
      "@prisma/adapter-pg": "~7.10.1",
      "tailwindcss": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "typescript": "7.0.2",
      "prettier": "^3.9.10",
      "electron": "44.9.3",
      "electron-vite": "6.0.0",
      "electron-builder": "26.18.0",
      "@types/bun": "1.4.3",
      "tailwind-merge": "^3.7.0",
      "lucide-react": "^1.61.0",
      "vite": "^8.3.5",
      "@vitejs/plugin-react": "^6.1.2",
      "@rolldown/plugin-babel": "^0.2.4",
      "@babel/core": "^7.29.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "@base-ui/react": "^1.9.0"
    }
  },
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "init": "bun scripts/init.ts",
    "sync": "bun scripts/sync.ts",
    "upgrade:expo": "bun scripts/upgrade-expo.ts",
    "add:mobile": "bun scripts/add-surface.ts mobile",
    "add:desktop": "bun scripts/add-surface.ts desktop",
    "add:ai": "bun recipes/add.ts ai",
    "add:ws": "bun recipes/add.ts ws",
    "add:jobs": "bun recipes/add.ts jobs",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "start:local": "bun run --cwd apps/web start:local",
    "release": "bun run --cwd apps/desktop release",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:ui": "bun run --cwd apps/web test:e2e:ui",
    "test:e2e:update": "bun run --cwd apps/web test:e2e:update",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:migrate:create": "bun run --cwd apps/web db:migrate:create",
    "db:migrate:sql": "bun run --cwd apps/web db:migrate:sql",
    "db:deploy": "bun run --cwd apps/web db:deploy",
    "db:studio": "bun run --cwd apps/web db:studio",
    "tokens": "bun run --cwd packages/tokens emit",
    "brand": "bun run --cwd packages/brand emit",
    "prettier": "prettier ."
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
